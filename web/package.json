    "zod": "4.6.5",
    "@hookform/resolvers": "5.9.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.6.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.28",
