# =============================================================================
# .env.example — copy to .env and adjust for your local environment
# NEVER commit .env — it is in .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Django core
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token-hex-50
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# -----------------------------------------------------------------------------
# Database (overridden in docker-compose.yml for containers)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://ticket:ticket@localhost:5433/ticket
DB_CONN_MAX_AGE=60

# -----------------------------------------------------------------------------
# Redis (overridden in docker-compose.yml for containers)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0

# -----------------------------------------------------------------------------
# CORS / CSRF origins (comma-separated)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8081

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000/api/v1

# For Android emulator inside Docker, use: http://10.0.2.2:8000/api/v1
# For LAN device, use your machine IP: http://192.168.x.x:8000/api/v1
MOBILE_API_BASE_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# Email (Mailpit local sink — no credentials needed)
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Ticket <noreply@ticket.local>

# -----------------------------------------------------------------------------
# Payments — mock mode works offline (no external credentials needed)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock

# To enable Stripe TEST mode (optional):
#   1. Set STRIPE_ENABLED=True
#   2. Use only test keys (start with sk_test_ / pk_test_)
STRIPE_ENABLED=False
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Reservation engine
# -----------------------------------------------------------------------------
RESERVATION_HOLD_MINUTES=10

# -----------------------------------------------------------------------------
# Frontend (consumed by Vite at build/dev time — must be prefixed VITE_)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Ticket

# Persist this key independently from Django JWT/password-reset signing.
TICKET_SIGNING_KEY=change-me-generate-with-python-secrets-token-hex-50
# Mobile: copy into mobile/.env when using a real LAN device.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
